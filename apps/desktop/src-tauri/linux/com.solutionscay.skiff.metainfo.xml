<component type="desktop-application">
  <id>com.solutionscay.skiff</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <name>Skiff</name>
  <summary>A minimalist workspace for coding agents</summary>
  <developer id="com.solutionscay">
    <name>Solutions Cay LLC</name>
  </developer>

  <description>
    <p>
      Skiff keeps agent and shell sessions organized across projects and Git
      worktrees. Themes and terminal layouts help you keep track of your work.
    </p>
    <p>
      Editing and previews stay in the apps you already use. Sessions run in a
      daemon and keep running when the window closes.
    </p>
  </description>

  <launchable type="desktop-id">Skiff.desktop</launchable>
  <provides>
    <binary>skiff-desktop</binary>
  </provides>

  <categories>
    <category>Development</category>
  </categories>
